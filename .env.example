# ==============================================================================
# Dangling Dice VPN & Developer Platform - Environment Configuration
# ==============================================================================

# Core Domain Configuration (Point DNS A/AAAA records to your server IP)
DOMAIN=danglingdice.com
API_DOMAIN=api.danglingdice.com
TOOLS_DOMAIN=tools.danglingdice.com
ACME_EMAIL=admin@danglingdice.com

# Server Public Networking
SERVER_PUBLIC_IP=123.456.78.90
VPN_LISTEN_PORT=51820

# WireGuard Internal VPN Subnet
VPN_SUBNET=10.8.0.0/24
VPN_GATEWAY_IP=10.8.0.1
VPN_DNS_SERVER=1.1.1.1,1.0.0.1

# Database Configuration (PostgreSQL)
POSTGRES_USER=dangling_user
POSTGRES_PASSWORD=change_this_to_a_secure_random_password_1234
POSTGRES_DB=dangling_dice_db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=change_this_redis_password_secure_5678

# Control Plane API & Security
JWT_SECRET=generate_a_64_character_random_hex_string_here
API_PORT=8080
APP_ENV=production
DEBUG=false

# Developer Tools Settings
ALLOW_GUEST_PROFILES=true
DEFAULT_GUEST_EXPIRY_HOURS=24
FREE_TIER_MAX_DEVICES=3

