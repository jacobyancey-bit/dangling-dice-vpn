{
    # Global options
    admin off
}

# ==============================================================================
# 1. Main Studio Website Domain (https://danglingdicestudios.duckdns.org)
#    Isolated Container: dangling-studio (studio:80)
# ==============================================================================
danglingdicestudios.duckdns.org {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization"
    }

    # Route /api/* (Studio Catalog /api/items and VPN /api/v1/*) to Go API
    handle /api* {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /health {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Route all website pages/assets to the isolated Studio Website Container
    handle {
        reverse_proxy studio:80 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

# ==============================================================================
# 2. Standalone VPN & SSOT Telemetry Subdomain (https://vpn.danglingdicestudios.duckdns.org)
#    Isolated Container: dangling-web (web:3000)
# ==============================================================================
vpn.danglingdicestudios.duckdns.org {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization"
    }

    # Route /api/* to Go API
    handle /api* {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /health {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Route all requests (/ and /admin and /vpn-widget.js) to the isolated VPN Container
    handle {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

# ==============================================================================
# 3. Direct IP & Localhost Access (For IP diagnostics & local healthchecks)
# ==============================================================================
http://165.245.142.71, http://localhost {
    encode zstd gzip

    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization"
    }

    handle /api* {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /health {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        reverse_proxy studio:80 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}
