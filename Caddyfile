{
    # Global options
    admin off
}

# 1. Production HTTPS Domain (Automatic Let's Encrypt SSL/TLS & HTTP/3 QUIC)
danglingdicestudios.duckdns.org {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization"
    }

    # Route /api/* (both Studio Catalog /api/items and VPN /api/v1/*) to Go API
    handle /api* {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Route /health to API
    handle /health {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Root '/' serves the Main Dangling Dice Studios™ Website (studio.html)
    # '/vpn' serves the Standalone Next.js VPN Portal
    # '/admin' serves the SSOT Analytics & A/B Testing Dashboard
    handle {
        @root path /
        rewrite @root /studio.html
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

# 2. Direct IP & Localhost Access (For immediate IP diagnostics & local healthchecks)
http://165.245.142.71, http://localhost {
    encode zstd gzip

    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization"
    }

    handle /api* {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /health {
        reverse_proxy api:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        @root path /
        rewrite @root /studio.html
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}
