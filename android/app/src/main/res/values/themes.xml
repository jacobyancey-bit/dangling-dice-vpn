<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- App & Splash Screen Theme -->
    <style name="Theme.DanglingDiceVPN" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Fallback window background for Android 8-11 -->
        <item name="android:windowBackground">#132241</item>
        <item name="android:statusBarColor">#020617</item>
        <item name="android:navigationBarColor">#020617</item>

        <!-- Android 12+ (API 31+) Native Splash Screen Configuration -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#132241</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">#132241</item>
    </style>
</resources>
